# MongoDB — local Docker replica set: docker-compose up -d
# DATABASE_URL="mongodb://127.0.0.1:27017/yemi-bingo?replicaSet=rs0&directConnection=true"
# Atlas: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/yemi-bingo?retryWrites=true&w=majority
DATABASE_URL="mongodb://127.0.0.1:27017/yemi-bingo?replicaSet=rs0&directConnection=true"

# NextAuth — app URL (use your production domain in prod)
NEXTAUTH_URL="http://localhost:3000"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
